{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nebula-observability.io/releases/manifest.schema.json",
  "type": "object",
  "required": ["release", "protocols", "otel_schema", "components"],
  "properties": {
    "release": { "type": "string", "pattern": "^[0-9]{4}[.][0-9]{2}[.][0-9]+(-[0-9A-Za-z.-]+)?$" },
    "protocols": {
      "type": "object",
      "required": ["rutp", "apm_extension"],
      "properties": {
        "rutp": { "type": "string" },
        "apm_extension": { "type": "string" }
      },
      "additionalProperties": false
    },
    "otel_schema": { "type": "string" },
    "components": { "type": "object", "additionalProperties": { "type": ["string", "null"] } }
  },
  "additionalProperties": false
}
