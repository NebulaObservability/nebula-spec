{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nebula-observability.io/otlp/metrics-export.schema.json",
  "type": "object",
  "required": ["resourceMetrics"],
  "properties": {
    "resourceMetrics": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/resourceMetrics" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "anyValue": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "stringValue": { "type": "string" },
        "boolValue": { "type": "boolean" },
        "intValue": { "type": "string", "pattern": "^-?[0-9]+$" },
        "doubleValue": { "type": "number" }
      },
      "additionalProperties": false
    },
    "keyValue": {
      "type": "object",
      "required": ["key", "value"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "value": { "$ref": "#/$defs/anyValue" }
      },
      "additionalProperties": false
    },
    "attributes": {
      "type": "array",
      "items": { "$ref": "#/$defs/keyValue" }
    },
    "exemplar": {
      "type": "object",
      "required": ["timeUnixNano", "traceId", "spanId"],
      "properties": {
        "filteredAttributes": { "type": "array", "maxItems": 0 },
        "timeUnixNano": { "$ref": "#/$defs/uint64" },
        "asDouble": { "type": "number" },
        "asInt": { "type": "string", "pattern": "^-?[0-9]+$" },
        "traceId": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
        "spanId": { "type": "string", "pattern": "^[0-9a-f]{16}$" }
      },
      "oneOf": [{ "required": ["asDouble"] }, { "required": ["asInt"] }],
      "additionalProperties": false
    },
    "uint64": { "type": "string", "pattern": "^[0-9]+$" },
    "otelSchemaUrl": {
      "oneOf": [
        { "const": "" },
        {
          "type": "string",
          "pattern": "^https://opentelemetry[.]io/schemas/(0|[1-9][0-9]*)[.](0|[1-9][0-9]*)[.](0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:[.][0-9A-Za-z-]+)*)?(?:[+][0-9A-Za-z-]+(?:[.][0-9A-Za-z-]+)*)?$"
        }
      ]
    },
    "numberPoint": {
      "type": "object",
      "required": ["timeUnixNano"],
      "properties": {
        "attributes": { "$ref": "#/$defs/attributes" },
        "startTimeUnixNano": { "$ref": "#/$defs/uint64" },
        "timeUnixNano": { "$ref": "#/$defs/uint64" },
        "asDouble": { "type": "number" },
        "asInt": { "type": "string", "pattern": "^-?[0-9]+$" },
        "exemplars": { "type": "array", "items": { "$ref": "#/$defs/exemplar" } }
      },
      "oneOf": [{ "required": ["asDouble"] }, { "required": ["asInt"] }],
      "additionalProperties": false
    },
    "buckets": {
      "type": "object",
      "required": ["offset", "bucketCounts"],
      "properties": {
        "offset": { "type": "integer" },
        "bucketCounts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/uint64" } }
      },
      "additionalProperties": false
    },
    "exponentialHistogramPoint": {
      "type": "object",
      "required": ["attributes", "startTimeUnixNano", "timeUnixNano", "count", "scale", "zeroCount"],
      "properties": {
        "attributes": { "$ref": "#/$defs/attributes" },
        "startTimeUnixNano": { "$ref": "#/$defs/uint64" },
        "timeUnixNano": { "$ref": "#/$defs/uint64" },
        "count": { "$ref": "#/$defs/uint64" },
        "sum": { "type": "number" },
        "scale": { "type": "integer", "minimum": -10, "maximum": 20 },
        "zeroCount": { "$ref": "#/$defs/uint64" },
        "positive": { "$ref": "#/$defs/buckets" },
        "negative": { "$ref": "#/$defs/buckets" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "exemplars": { "type": "array", "items": { "$ref": "#/$defs/exemplar" } }
      },
      "additionalProperties": false
    },
    "histogramPoint": {
      "type": "object",
      "required": ["attributes", "startTimeUnixNano", "timeUnixNano", "count", "bucketCounts", "explicitBounds"],
      "properties": {
        "attributes": { "$ref": "#/$defs/attributes" },
        "startTimeUnixNano": { "$ref": "#/$defs/uint64" },
        "timeUnixNano": { "$ref": "#/$defs/uint64" },
        "count": { "$ref": "#/$defs/uint64" },
        "sum": { "type": "number" },
        "bucketCounts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/uint64" } },
        "explicitBounds": { "type": "array", "items": { "type": "number" } },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "exemplars": { "type": "array", "items": { "$ref": "#/$defs/exemplar" } }
      },
      "additionalProperties": false
    },
    "gauge": {
      "type": "object",
      "required": ["dataPoints"],
      "properties": { "dataPoints": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/numberPoint" } } },
      "additionalProperties": false
    },
    "sum": {
      "type": "object",
      "required": ["dataPoints", "aggregationTemporality", "isMonotonic"],
      "properties": {
        "dataPoints": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/numberPoint" } },
        "aggregationTemporality": { "enum": [1, 2] },
        "isMonotonic": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "histogram": {
      "type": "object",
      "required": ["dataPoints", "aggregationTemporality"],
      "properties": {
        "dataPoints": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/histogramPoint" } },
        "aggregationTemporality": { "enum": [1, 2] }
      },
      "additionalProperties": false
    },
    "exponentialHistogram": {
      "type": "object",
      "required": ["dataPoints", "aggregationTemporality"],
      "properties": {
        "dataPoints": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/exponentialHistogramPoint" } },
        "aggregationTemporality": { "enum": [1, 2] }
      },
      "additionalProperties": false
    },
    "metric": {
      "type": "object",
      "required": ["name", "unit"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "unit": { "type": "string", "minLength": 1 },
        "gauge": { "$ref": "#/$defs/gauge" },
        "sum": { "$ref": "#/$defs/sum" },
        "histogram": { "$ref": "#/$defs/histogram" },
        "exponentialHistogram": { "$ref": "#/$defs/exponentialHistogram" }
      },
      "oneOf": [
        { "required": ["gauge"] },
        { "required": ["sum"] },
        { "required": ["histogram"] },
        { "required": ["exponentialHistogram"] }
      ],
      "additionalProperties": false
    },
    "scopeMetrics": {
      "type": "object",
      "required": ["scope", "metrics"],
      "properties": {
        "scope": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1, "maxLength": 128 }
          },
          "additionalProperties": false
        },
        "metrics": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/metric" } },
        "schemaUrl": { "$ref": "#/$defs/otelSchemaUrl" }
      },
      "additionalProperties": false
    },
    "resourceMetrics": {
      "type": "object",
      "required": ["resource", "scopeMetrics"],
      "properties": {
        "resource": {
          "type": "object",
          "required": ["attributes"],
          "properties": { "attributes": { "$ref": "#/$defs/attributes" } },
          "additionalProperties": false
        },
        "scopeMetrics": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scopeMetrics" } },
        "schemaUrl": { "$ref": "#/$defs/otelSchemaUrl" }
      },
      "additionalProperties": false
    }
  }
}
